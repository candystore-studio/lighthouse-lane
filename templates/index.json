              "settings": {
                "label": "View all",
                "open_in_new_tab": false,
                "style_class": "link",
                "width": "fit-content",
                "width_mobile": "fit-content"
              }
            }
          },
          "block_order": ["bestsellers_heading_group", "bestsellers_view_all"]
