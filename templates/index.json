        "static-product-card": {
          "type": "_product-card",
          "name": "t:names.product_card",
          "static": true,
          "settings": {
            "product_card_gap": 9,
            "border": "none",
            "border_width": 1,
            "border_opacity": 100,
            "border_radius": 0
          },
          "blocks": {
            "bestsellers_card_gallery": {
              "type": "_product-card-gallery",
              "name": "t:names.product_card_media",
              "settings": {
                "image_ratio": "portrait",
                "border": "solid",
                "border_width": 1,
                "border_opacity": 100,
                "border_radius": 3
              }
            },
            "bestsellers_card_title": {
              "type": "product-title",
              "name": "t:names.product_title",
              "settings": {
                "width": "100%",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "custom",
                "font": "var(--font-body--family)",
                "font_size": "0.875rem",
                "line_height": "tight",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty",
                "padding-block-start": 4
              }
            },
            "bestsellers_card_review": {
              "type": "review",
              "name": "t:names.review",
              "settings": {
                "show_number": true,
                "alignment": "left"
              }
            },
            "bestsellers_card_price": {
              "type": "price",
              "name": "t:names.product_price",
              "settings": {
                "show_sale_price_first": true,
                "show_installments": false,
                "show_tax_info": false,
                "type_preset": "custom",
                "width": "100%",
                "alignment": "left",
                "font": "var(--font-heading--family)",
                "font_size": "0.875rem",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none"
              }
            }
          },
          "block_order": [
            "bestsellers_card_gallery",
            "bestsellers_card_title",
            "bestsellers_card_review",
            "bestsellers_card_price"
          ]
        }
      },
      "name": "t:names.product_list",
      "settings": {
        "collection": "all",
        "layout_type": "grid",
        "carousel_on_mobile": false,
        "max_products": 4,
        "columns": 4,
        "mobile_columns": "2",
        "columns_gap": 28,
        "rows_gap": 24,
        "section_width": "page-width",
        "horizontal_alignment": "flex-start",
        "gap": 32,
        "padding-block-start": 72,
        "padding-block-end": 64
