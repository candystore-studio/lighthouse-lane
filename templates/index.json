{
  "sections": {
    "ll_hero": {
      "type": "media-with-content",
      "blocks": {
        "media": {
          "type": "_media-without-appearance",
          "static": true,
          "settings": {
            "media_type": "image",
            "image_position": "cover"
          }
        },
        "content": {
          "type": "_content-without-appearance",
          "static": true,
          "settings": {
            "horizontal_alignment_flex_direction_column": "flex-start",
            "vertical_alignment_flex_direction_column": "center",
            "gap": 18
          },
          "blocks": {
            "hero_aside": {
              "type": "ll-hand-aside",
              "settings": {
                "text": "Ey up! — independent · family-run · Yorkshire",
                "font_size": "1.5rem",
                "rotation": -1.5
              }
            },
            "hero_heading": {
              "type": "text",
              "name": "t:names.heading",
              "settings": {
                "text": "<h1>Lorem ipsum dolor sit amet consectetur</h1>",
                "width": "100%",
                "max_width": "normal",
                "alignment": "left",
                "type_preset": "h1",
                "font": "var(--font-heading--family)",
                "line_height": "tight",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty"
              }
            },
            "hero_text": {
              "type": "text",
              "name": "t:names.text",
              "settings": {
                "text": "<p>Sed do eiusmod tempor incididunt ut labore et dolore magna aliqua ut enim ad minim.</p>",
                "width": "100%",
                "max_width": "narrow",
                "alignment": "left",
                "type_preset": "paragraph",
                "font": "var(--font-body--family)",
                "line_height": "normal",
                "letter_spacing": "normal",
                "case": "none",
                "wrap": "pretty"
              }
            },
            "hero_buttons": {
              "type": "group",
              "name": "t:names.buttons",
              "settings": {
                "content_direction": "row",
                "vertical_on_mobile": true,
                "horizontal_alignment": "flex-start",
                "vertical_alignment": "center",
                "gap": 14,
                "width": "fill",
                "width_mobile": "fill",
                "height": "fit"
              },
              "blocks": {
                "hero_button_primary": {
                  "type": "button",
                  "name": "t:names.button",
                  "settings": {
                    "label": "Shop Bestsellers",
                    "link": "shopify://collections/all",
                    "open_in_new_tab": false,
                    "style_class": "button",
                    "width": "fit-content",
                    "width_mobile": "fill"
                  }
                },
                "hero_button_secondary": {
                  "type": "button",
                  "name": "t:names.button",
                  "settings": {
                    "label": "Katie's Art",
                    "link": "shopify://collections/all",
                    "open_in_new_tab": false,
                    "style_class": "button-secondary",
                    "width": "fit-content",
                    "width_mobile": "fill"
                  }
                }
              },
              "block_order": ["hero_button_primary", "hero_button_secondary"]
            }
          },
          "block_order": ["hero_aside", "hero_heading", "hero_text", "hero_buttons"]
        }
      },
      "name": "t:names.media_with_content",
      "settings": {
        "media_position": "right",
        "media_width": "medium",
        "media_height": "auto",
        "section_width": "page-width",
        "extend_media": false,
        "background_color": "#EFE7D2",
        "padding-block-start": 40,
        "padding-block-end": 40
      }
    },
    "ll_trust": {
      "type": "ll-trust-strip",
      "blocks": {
        "stat_shops": {
          "type": "_ll-stat",
          "settings": {
            "stat": "Three shops",
            "label": "Haworth · Skipton · Harrogate"
          }
        },
        "stat_years": {
          "type": "_ll-stat",
          "settings": {
            "stat": "11 years",
            "label": "Trading since 2015"
          }
        },
        "stat_family": {
          "type": "_ll-stat",
          "settings": {
            "stat": "Designed by us",
            "label": "Katie & Howard, family run"
          }
        },
        "stat_rating": {
          "type": "_ll-stat",
          "settings": {
            "stat": "4.9 rated",
            "label": "212 reviews on Judge.me",
            "show_star": true
          }
        }
      },
      "block_order": ["stat_shops", "stat_years", "stat_family", "stat_rating"],
      "name": "Trust strip",
      "settings": {
        "background_color": "#43573E",
        "padding-block-start": 0,
        "padding-block-end": 0
      }
    },
    "ll_bestsellers": {
