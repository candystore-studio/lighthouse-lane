{% comment %}
  Shop card — a luggage label tied to each shop.

  Private block, only offered inside the Shop cards section. Shopfront photo,
  Bevan place name, address/hours line and a "Get directions" link, with the
  punched hole and string-tag rotation drawn in CSS by the parent section.

  Mobile has two shapes, per the design: the lead shop keeps its full card,
  the rest collapse to compact rows with a chevron (the directions link
  stretches over the whole row so the tap target is the card).
{% endcomment %}

{%- liquid
  assign block_settings = block.settings
  assign sizes = '(min-width: 750px) 33vw, 100vw'
  assign widths = '320, 480, 640, 960, 1280'
-%}

<article
  class="ll-shop-card ll-shop-card--mobile-{{ block_settings.mobile_style }}"
  {{ block.shopify_attributes }}
>
  <span class="ll-shop-card__hole" aria-hidden="true"></span>

  <div class="ll-shop-card__media">
    {%- if block_settings.image -%}
      {{
        block_settings.image
        | image_url: width: 1280
        | image_tag: widths: widths, sizes: sizes, class: 'll-shop-card__image'
      }}
    {%- else -%}
      <div class="ll-shop-card__placeholder">
        <span class="ll-shop-card__placeholder-note">Shopfront photo{% if block_settings.name != blank %} — {{ block_settings.name | strip_html }}{% endif %}</span>
      </div>
    {%- endif -%}
  </div>

  <div class="ll-shop-card__body">
    {%- if block_settings.name != blank -%}
      <h3 class="ll-shop-card__name">{{ block_settings.name }}</h3>
    {%- endif -%}
    {%- if block_settings.details != blank -%}
      <p class="ll-shop-card__details">{{ block_settings.details }}</p>
    {%- endif -%}
    {%- if block_settings.link != blank -%}
      <a class="ll-shop-card__link" href="{{ block_settings.link }}">
        {{- block_settings.link_label | default: 'Get directions' -}}
      </a>
    {%- endif -%}
    <span class="ll-shop-card__chevron" aria-hidden="true">›</span>
  </div>
</article>

{% stylesheet %}
  .ll-shop-card {
    position: relative;
    background: var(--ll-paper, #f8f3e6);
    border: 1px solid var(--ll-stitch-color, #d6cbb1);
    border-radius: var(--ll-radius-tight, 3px);
    overflow: hidden;
  }

  .ll-shop-card__hole {
    position: absolute;
    top: 10px;
    left: 10px;
    z-index: 1;
    width: 14px;
    height: 14px;
    border-radius: 50%;
    background: var(--ll-paper-aged, #efe7d2);
    border: 1px solid var(--ll-border-strong, #c9bc9f);
  }

  .ll-shop-card__media {
    height: 180px;
    border-block-end: 1px solid var(--ll-stitch-color, #d6cbb1);
  }

  .ll-shop-card__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }

  /* Pencil-hatch placeholder until Katie's shopfront photos arrive. */
  .ll-shop-card__placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    background: repeating-linear-gradient(45deg, rgb(110 100 84 / 0.1) 0 1px, transparent 1px 8px) var(--ll-paper-tint, #f1ead8);
  }

  .ll-shop-card__placeholder-note {
    font-family: var(--font-accent--family);
    font-weight: var(--font-accent--weight);
    font-size: 1.0625rem;
    color: var(--ll-peat, #6e6454);
  }

  .ll-shop-card__body {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 18px 24px 20px;
  }

  .ll-shop-card__name {
    margin: 0;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    font-size: 1.125rem; /* 18px */
    line-height: 1.3;
  }

  .ll-shop-card__details {
    margin: 0;
    font-size: 0.875rem; /* 14px */
    line-height: 1.5;
    color: var(--ll-peat, #6e6454);
  }

  .ll-shop-card__link {
    width: fit-content;
    font-size: 0.875rem;
    font-weight: 800;
    color: var(--color-foreground);
    text-decoration: underline;
    text-decoration-color: var(--ll-vermillion, #bf4a33);
    text-underline-offset: 4px;
  }

  .ll-shop-card__chevron {
    display: none;
  }

  /* Compact row — mobile only, per the design. */
  @media screen and (max-width: 749px) {
    .ll-shop-card__hole {
      top: 8px;
      left: 8px;
      width: 12px;
      height: 12px;
    }

    .ll-shop-card--mobile-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      padding: 16px 20px 16px 32px;
    }

    .ll-shop-card--mobile-row .ll-shop-card__hole {
      top: 50%;
      left: 10px;
      translate: 0 -50%;
    }

    .ll-shop-card--mobile-row .ll-shop-card__media {
      display: none;
    }

    .ll-shop-card--mobile-row .ll-shop-card__body {
      flex: 1;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      gap: 2px 12px;
      padding: 0;
      flex-wrap: wrap;
    }

    .ll-shop-card--mobile-row .ll-shop-card__name {
      font-size: 1rem;
      flex-basis: 100%;
    }

    .ll-shop-card--mobile-row .ll-shop-card__details {
      font-size: 0.8125rem;
    }

    /* The whole row is the tap target; the label hides but stays readable
       to assistive tech, and the chevron takes its visual place. */
    .ll-shop-card--mobile-row .ll-shop-card__link {
      position: absolute;
      inset: 0;
      overflow: hidden;
      text-indent: -200vw;
      text-decoration: none;
    }

    .ll-shop-card--mobile-row .ll-shop-card__chevron {
      display: block;
      margin-inline-start: auto;
      font-size: 1.125rem;
      color: var(--ll-moor, #43573e);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop",
  "tag": null,
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Shopfront photo"
    },
    {
      "type": "text",
      "id": "name",
      "label": "Shop name",
      "default": "Haworth"
    },
    {
      "type": "inline_richtext",
      "id": "details",
      "label": "Address and hours",
      "default": "Address<br>Open daily 10am–5pm"
    },
    {
      "type": "url",
      "id": "link",
      "label": "Directions link",
      "info": "Usually a Google Maps link."
    },
    {
      "type": "text",
      "id": "link_label",
      "label": "Link label",
      "default": "Get directions"
    },
    {
      "type": "select",
      "id": "mobile_style",
      "label": "Mobile layout",
      "options": [
        {
          "value": "card",
          "label": "Full card"
        },
        {
          "value": "row",
          "label": "Compact row"
        }
      ],
      "default": "row"
    }
  ]
}
{% endschema %}
