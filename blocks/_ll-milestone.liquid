{% comment %}
  Milestone — one chapter of the story.

  Private block, only offered inside the Timeline section. The same markup
  serves both layouts: on desktop the article is `display: contents` so its
  three parts drop straight onto the section's year / rail / content grid; on
  mobile it collapses into a card on the swipe track.

  Accent colour is not a setting. The first and last milestones take
  vermillion from the section's CSS, everything between is moor green, so the
  story always opens and closes on the same note however many chapters
  Howard adds.
{% endcomment %}

{%- liquid
  assign block_settings = block.settings
  assign has_image = false
  if block_settings.image != blank
    assign has_image = true
  endif
  assign show_media = has_image
  if block_settings.show_placeholder
    assign show_media = true
  endif
-%}

<article class="ll-milestone" data-has-media="{{ show_media }}" {{ block.shopify_attributes }}>
  <div class="ll-milestone__year">
    {%- if block_settings.year != blank -%}
      <span class="ll-milestone__year-figure">{{ block_settings.year }}</span>
    {%- endif -%}
    {%- if block_settings.year_note != blank -%}
      <span class="ll-milestone__year-note">{{ block_settings.year_note }}</span>
    {%- endif -%}
  </div>

  <div class="ll-milestone__rail" aria-hidden="true">
    <span class="ll-milestone__dot"></span>
  </div>

  <div class="ll-milestone__body">
    <div class="ll-milestone__copy">
      {%- if block_settings.title != blank -%}
        <h3 class="ll-milestone__title">{{ block_settings.title }}</h3>
      {%- endif -%}
      {%- if block_settings.text != blank -%}
        <div class="ll-milestone__text rte">{{ block_settings.text }}</div>
      {%- endif -%}
      {%- if block_settings.note != blank -%}
        <span class="ll-milestone__note">{{ block_settings.note }}</span>
      {%- endif -%}
    </div>

    {%- if show_media -%}
      <div class="ll-milestone__media">
        {%- if has_image -%}
          {{
            block_settings.image
            | image_url: width: 900
            | image_tag:
              widths: '240, 300, 480, 600, 900',
              sizes: '(min-width: 750px) 300px, 222px',
              class: 'll-milestone__image'
          }}
        {%- else -%}
          <div class="ll-milestone__placeholder">
            <span class="ll-milestone__placeholder-note">
              {{- block_settings.placeholder_note | default: 'Photo' -}}
            </span>
          </div>
        {%- endif -%}
      </div>
    {%- endif -%}
  </div>
</article>

{% stylesheet %}
  /* -- Desktop: three parts dropped onto the section grid ------------------ */
  @media screen and (min-width: 750px) {
    .ll-milestone {
      display: contents;
    }

    .ll-milestone__year {
      grid-column: 1;
      display: flex;
      flex-direction: column;
      align-items: flex-end;
      text-align: right;
      padding-block-end: 56px;
    }

    .ll-milestone__year-figure {
      font-family: var(--font-heading--family);
      font-style: var(--font-heading--style);
      font-weight: var(--font-heading--weight);
      font-size: 2.75rem; /* 44px */
      line-height: 1;
      color: var(--ll-milestone-accent, var(--ll-moor, #43573e));
    }

    .ll-milestone__year-note {
      font-family: var(--font-accent--family);
      font-weight: var(--font-accent--weight);
      font-size: 1.1875rem; /* 19px */
      color: var(--ll-peat, #6e6454);
    }

    .ll-milestone__rail {
      grid-column: 2;
      position: relative;
      border-inline-start: var(--ll-stitch, 2px dashed #c9bc9f);
    }

    /* The story stops at the last dot, so the rail below it does too. */
    .ll-milestone:last-child .ll-milestone__rail {
      border-inline-start: none;
    }

    .ll-milestone__dot {
      position: absolute;
      top: 6px;
      /* Centred on the 2px spine whatever size the dot is. */
      inset-inline-start: calc(1px - (var(--ll-milestone-dot-size, 10px) / 2));
      width: var(--ll-milestone-dot-size, 10px);
      height: var(--ll-milestone-dot-size, 10px);
      border-radius: 50%;
      background: var(--ll-milestone-accent, var(--ll-moor, #43573e));
      border: 2px solid var(--ll-paper, #f8f3e6);
    }

    .ll-milestone__body {
      grid-column: 3;
      display: grid;
      grid-template-columns: minmax(0, 1fr);
      gap: 32px;
      align-items: start;
      padding-block-end: 56px;
    }

    .ll-milestone[data-has-media='true'] .ll-milestone__body {
      grid-template-columns: minmax(0, 1fr) 300px;
    }

    /* Chapters without a photograph read as a paragraph, not a wide banner. */
    .ll-milestone__copy {
      max-width: 38.75rem; /* 620px */
    }

    .ll-milestone:last-child .ll-milestone__year,
    .ll-milestone:last-child .ll-milestone__body {
      padding-block-end: 0;
    }

    .ll-milestone__media {
      aspect-ratio: 4 / 3;
      rotate: var(--ll-milestone-media-rotation, -1deg);
    }
  }

  /* -- Shared type --------------------------------------------------------- */
  .ll-milestone__copy {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .ll-milestone__title {
    margin: 0;
    font-family: var(--font-heading--family);
    font-style: var(--font-heading--style);
    font-weight: var(--font-heading--weight);
    font-size: 1.3125rem; /* 21px */
    line-height: 1.3;
  }

  .ll-milestone__text {
    font-size: 1rem;
    line-height: 1.7;
    color: var(--ll-peat, #6e6454);
  }

  .ll-milestone__text > :first-child {
    margin-block-start: 0;
  }

  .ll-milestone__text > :last-child {
    margin-block-end: 0;
  }

  .ll-milestone__note {
    align-self: flex-start;
    font-family: var(--font-accent--family);
    font-weight: var(--font-accent--weight);
    font-size: 1.1875rem; /* 19px */
    color: var(--ll-moor, #43573e);
    rotate: -0.8deg;
  }

  .ll-milestone__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    border: 1px solid var(--ll-stitch-color, #d6cbb1);
  }

  .ll-milestone__placeholder {
    display: grid;
    place-items: center;
    height: 100%;
    padding: 10px;
    text-align: center;
    background: repeating-linear-gradient(45deg, rgb(110 100 84 / 0.1) 0 1px, transparent 1px 8px) var(--ll-paper-tint, #f1ead8);
    border: 1px solid var(--ll-stitch-color, #d6cbb1);
  }

  .ll-milestone__placeholder-note {
    font-family: var(--font-accent--family);
    font-weight: var(--font-accent--weight);
    font-size: 1rem;
    color: var(--ll-peat, #6e6454);
  }

  /* -- Mobile: a card on the swipe track ----------------------------------- */
  @media screen and (max-width: 749px) {
    .ll-milestone {
      position: relative;
      flex: 0 0 15.875rem; /* 254px */
      display: flex;
      flex-direction: column;
      gap: 8px;
      padding: 16px;
      background: var(--ll-paper-card, #fdfaf0);
      border: 1px solid var(--ll-border-strong, #c9bc9f);
      border-radius: var(--ll-radius-tight, 3px);
      box-shadow: 2px 3px 0 rgb(46 42 36 / 0.1);
      scroll-snap-align: start;
    }

    .ll-milestone__year-figure {
      font-family: var(--font-heading--family);
      font-style: var(--font-heading--style);
      font-weight: var(--font-heading--weight);
      font-size: 1.875rem; /* 30px */
      line-height: 1;
      color: var(--ll-milestone-accent, var(--ll-moor, #43573e));
    }

    /* The pencilled sub-label is a desktop margin note; the card has no room
       for it and the design drops it. */
    .ll-milestone__year-note {
      display: none;
    }

    .ll-milestone__rail {
      position: absolute;
      top: -27px;
      inset-inline-start: 18px;
    }

    .ll-milestone__dot {
      display: block;
      width: var(--ll-milestone-dot-size, 10px);
      height: var(--ll-milestone-dot-size, 10px);
      border-radius: 50%;
      background: var(--ll-milestone-accent, var(--ll-moor, #43573e));
      border: 2px solid var(--ll-paper, #f8f3e6);
    }

    .ll-milestone__body {
      display: flex;
      flex-direction: column;
      gap: 8px;
    }

    .ll-milestone__title {
      font-size: 1rem; /* 16px */
    }

    .ll-milestone__text {
      font-size: 0.875rem; /* 14px */
      line-height: 1.6;
    }

    .ll-milestone__note {
      font-size: 1rem;
    }

    .ll-milestone__media {
      height: 7rem; /* 112px */
      margin-block-start: 4px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ll-milestone__media,
    .ll-milestone__note {
      rotate: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Milestone",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "year",
      "label": "Year",
      "default": "2015"
    },
    {
      "type": "text",
      "id": "year_note",
      "label": "Pencilled sub-label",
      "info": "Handwritten line under the year. Desktop only.",
      "default": "where it starts"
    },
    {
      "type": "inline_richtext",
      "id": "title",
      "label": "Title",
      "default": "A small shop in Haworth"
    },
    {
      "type": "richtext",
      "id": "text",
      "label": "Copy"
    },
    {
      "type": "text",
      "id": "note",
      "label": "Handwritten aside",
      "info": "Optional Caveat line under the copy, e.g. rent were £00 a month, mind."
    },
    {
      "type": "header",
      "content": "Photo"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Photo"
    },
    {
      "type": "checkbox",
      "id": "show_placeholder",
      "label": "Show placeholder when no photo",
      "info": "Keeps the hatched box in place while you wait on the photograph. Untick for a chapter that is copy only.",
      "default": false
    },
    {
      "type": "text",
      "id": "placeholder_note",
      "label": "Placeholder caption",
      "default": "Photo",
      "visible_if": "{{ block.settings.show_placeholder }}"
    }
  ]
}
{% endschema %}
