            "details": "<p>Address 2<br>Open daily 10am–5pm</p>",
            "address": "<p>Address 2</p>",
            "mobile_open": false
          }
        },
        "shop_harrogate": {
          "type": "_ll-shop-card",
          "settings": {
            "name": "Harrogate",
