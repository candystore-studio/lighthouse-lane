{% comment %}
  Shop cards — the three shops, as labels or as rows.

  Aged-paper band opened by a stitched seam. Heading row pairs the Bevan
  title with a hand aside (the global `ll-hand-aside` block, rendered
  statically so it is editable in the theme editor but cannot wander off).

  Two desktop layouts off one setting, so the shops are authored once:

    labels — the homepage: three luggage labels tied on at slightly
             different angles, the middle one hanging lower
    rows   — the About page: full-width panels, photo alternating side to
             side down the page

  Cards are `_ll-shop-card` blocks; the rotations, the middle card's drop and
  the row alternation are dealt here by position so the cards stay clean.

  On mobile both layouts are the same disclosure group: one card open at a
  time, handled by <ll-shop-cards>. Desktop is untouched — every card open,
  as designed.
{% endcomment %}

<script
  src="{{ 'll-shop-cards.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{%- liquid
  if section.settings.background_color != blank
    render 'contrast-override', background_color: section.settings.background_color, section_id: section.id
  endif
-%}

<div
  class="section-background{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
></div>
<div
  {% if section.settings.anchor != blank %}
    id="{{ section.settings.anchor | handle }}"
  {% endif %}
  class="section section--page-width ll-shop-cards ll-shop-cards--{{ section.settings.layout | default: 'labels' }} spacing-style{% if section.settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}{% if section.settings.show_seam %} ll-shop-cards--seam{% endif %}"
  style="{% render 'spacing-style', settings: section.settings %}"
  {% if section.settings.anchor != blank %}
    tabindex="-1"
  {% endif %}
>
  <div class="ll-shop-cards__inner">
    {%- if section.settings.heading != blank -%}
      <div class="ll-shop-cards__header">
        <h2 class="ll-shop-cards__heading">{{ section.settings.heading }}</h2>
        {% content_for 'block', type: 'll-hand-aside', id: 'aside' %}
      </div>
    {%- endif -%}

    <ll-shop-cards class="ll-shop-cards__grid" data-mobile-breakpoint="749">
      {% content_for 'blocks' %}
    </ll-shop-cards>
  </div>
</div>

{% stylesheet %}
  .ll-shop-cards--seam {
    border-block-start: var(--ll-stitch, 2px dashed #d6cbb1);
  }

  .ll-shop-cards__inner {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .ll-shop-cards__header {
    display: flex;
    align-items: baseline;
    gap: 16px;
  }

  .ll-shop-cards__heading {
    margin: 0;
  }

  .ll-shop-cards__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 28px;
    align-items: start;
  }

  @media screen and (min-width: 750px) {
    .ll-shop-cards--labels .ll-shop-cards__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    /* String-tag scatter: tied on at slightly different angles, middle label
       hanging a touch lower. Repeats per row of three. */
    .ll-shop-cards--labels .ll-shop-cards__grid > :nth-child(3n + 1) {
      rotate: -0.8deg;
    }

    .ll-shop-cards--labels .ll-shop-cards__grid > :nth-child(3n + 2) {
      rotate: 0.6deg;
      margin-block-start: 14px;
    }

    .ll-shop-cards--labels .ll-shop-cards__grid > :nth-child(3n) {
      rotate: -0.4deg;
    }

    /* Rows read down the page with the photograph swapping sides, so the eye
       zig-zags rather than running down one edge. */
    .ll-shop-cards--rows .ll-shop-cards__grid > :nth-child(even) {
      grid-template-columns: minmax(0, 1fr) 25rem;
    }

    .ll-shop-cards--rows .ll-shop-cards__grid > :nth-child(even) .ll-shop-card__media {
      order: 2;
      border-inline-end: none;
      border-inline-start: var(--ll-stitch, 2px dashed #d6cbb1);
    }
  }

  @media screen and (max-width: 749px) {
    .ll-shop-cards__inner {
      gap: 16px;
    }

    .ll-shop-cards__header {
      flex-direction: column;
      gap: 2px;
    }

    .ll-shop-cards__grid {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }

    .ll-shop-cards__grid > :nth-child(3n + 1) {
      rotate: -0.5deg;
    }

    .ll-shop-cards__grid > :nth-child(3n + 2) {
      rotate: 0.4deg;
    }

    .ll-shop-cards__grid > :nth-child(3n) {
      rotate: -0.3deg;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ll-shop-cards__grid > * {
      rotate: none;
      margin-block-start: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop cards",
  "disabled_on": {
    "groups": ["header", "footer"]
  },
  "blocks": [
    {
      "type": "_ll-shop-card"
    }
  ],
  "settings": [
    {
      "type": "inline_richtext",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Visit our shops"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Desktop layout",
      "info": "Mobile is the same tap-to-open list either way.",
      "options": [
        {
          "value": "labels",
          "label": "Luggage labels (three across)"
        },
        {
          "value": "rows",
          "label": "Rows (photo beside the details)"
        }
      ],
      "default": "labels"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "default": "#EFE7D2"
    },
    {
      "type": "checkbox",
      "id": "show_seam",
      "label": "Stitched seam above",
      "default": true
    },
    {
      "type": "text",
      "id": "anchor",
      "label": "Anchor",
      "info": "Lets a button jump here, e.g. ll-about-shops linked as #ll-about-shops."
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "Shop cards",
      "category": "Lighthouse Lane",
      "blocks": {
        "aside": {
          "type": "ll-hand-aside",
          "static": true,
          "settings": {
            "text": "— come say ey up, since 2015",
            "font_size": "1.5rem",
            "rotation": -1
          }
        },
        "shop_haworth": {
          "type": "_ll-shop-card",
          "settings": {
            "name": "Haworth",
            "details": "<p>Address 1<br>Open daily 10am–5pm</p>",
            "mobile_open": true
          }
        },
        "shop_skipton": {
          "type": "_ll-shop-card",
          "settings": {
            "name": "Skipton",
            "details": "<p>Address 2<br>Open daily 10am–5pm</p>",
            "mobile_open": false
          }
        },
        "shop_harrogate": {
          "type": "_ll-shop-card",
          "settings": {
            "name": "Harrogate",
            "details": "<p>Address 3<br>Open daily 10am–5pm</p>",
            "mobile_open": false
          }
        }
      },
      "block_order": ["shop_haworth", "shop_skipton", "shop_harrogate"]
    },
    {
      "name": "Shop rows",
      "category": "Lighthouse Lane",
      "settings": {
        "layout": "rows",
        "heading": "Three shops across Yorkshire"
      },
      "blocks": {
        "aside": {
