{% comment %}
  Collection description — the long SEO copy, below the grid.

  Howard writes several hundred words per collection for search. Sat above the
  products that copy is the whole first screen on mobile and the grid never
  gets seen; sat below them it does the same job for search and stops
  competing with the thing people came for. The header keeps a one- or
  two-line intro (see `ll-collection-header`), this section carries the body.

  The text is `collection.description` verbatim — same field, same admin box,
  nothing for Howard to keep in two places. It is in the markup in full on
  every render; `<ll-expandable-text>` only limits how much is painted, so the
  clamp costs nothing in search and reads the same to a crawler as to a
  reader who never presses the button.

  `normalise_alignment` exists because Shopify's rich text editor writes
  `text-align` as an inline style on each paragraph, and a lot of the current
  descriptions are centred from when they sat under a centred heading.
  Centred long prose is hard to read — every line starts in a different place
  — and inline styles beat any stylesheet, so the override has to be
  `!important` to reach them. It stays a setting rather than a hard rule so a
  short, deliberately centred description can keep its alignment.

  Nothing renders when the description is empty, so the section can sit in
  `templates/collection.json` for every collection without leaving a gap on
  the ones Howard has not written yet.
{% endcomment %}

<script
  src="{{ 'll-expandable-text.js' | asset_url }}"
  type="module"
  fetchpriority="low"
></script>

{%- liquid
  assign section_settings = section.settings
  assign description = collection.description

  if section_settings.background_color != blank
    render 'contrast-override', background_color: section_settings.background_color, section_id: section.id
  endif
-%}

{%- if description != blank -%}
  <div
    class="section-background{% if section_settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
  ></div>
  <div
    class="section section--page-width ll-collection-description spacing-style{% if section_settings.background_color != blank %} color-custom-{{ section.id }}{% endif %}"
    style="{% render 'spacing-style', settings: section_settings %}"
  >
    <div
      class="ll-collection-description__inner{% if section_settings.show_top_rule %} ll-collection-description__inner--ruled{% endif %}"
    >
      {%- if section_settings.heading != blank -%}
        <h2 class="ll-collection-description__heading">{{ section_settings.heading }}</h2>
      {%- endif -%}

      {%- if section_settings.collapse -%}
        <ll-expandable-text
          class="ll-collection-description__disclosure"
          style="--ll-expandable-lines: {{ section_settings.collapsed_lines }};"
        >
          <div
            class="ll-collection-description__body rte{% if section_settings.normalise_alignment %} ll-collection-description__body--start{% endif %}"
            data-ll-expandable-body
            id="ll-collection-description-{{ section.id }}"
          >
            {{ description }}
          </div>

          <button
            class="ll-collection-description__toggle"
            type="button"
            aria-expanded="false"
            aria-controls="ll-collection-description-{{ section.id }}"
            data-ll-expandable-toggle
            hidden
          >
            <span class="ll-collection-description__toggle-label" data-when="collapsed">
              {{- section_settings.more_label | escape -}}
            </span>
            <span class="ll-collection-description__toggle-label" data-when="expanded">
              {{- section_settings.less_label | escape -}}
            </span>
            {%- comment -%}
              Decorative: the label already says which way this goes, so the
              caret is hidden from assistive tech rather than read out twice.
            {%- endcomment -%}
            <span class="ll-collection-description__toggle-caret" aria-hidden="true"></span>
          </button>
        </ll-expandable-text>

        {%- comment -%}
          The clamp is applied in CSS so there is no flash of the full block
          on load, which means a reader with JS off would be left with cut
          copy and no toggle. Drop the clamp for them.
        {%- endcomment -%}
        <noscript>
          <style>
            .ll-collection-description__body {
              max-height: none;
              mask-image: none;
            }
          </style>
        </noscript>
      {%- else -%}
        <div
          class="ll-collection-description__body ll-collection-description__body--open rte{% if section_settings.normalise_alignment %} ll-collection-description__body--start{% endif %}"
        >
          {{ description }}
        </div>
      {%- endif -%}
    </div>
  </div>
{%- elsif request.design_mode -%}
  <div class="section section--page-width ll-collection-description">
    <p class="ll-collection-description__placeholder">
      This collection has no description yet. Add one in Products → Collections and it will appear
      here. The section stays hidden on the live site until then.
    </p>
  </div>
{%- endif -%}

{% stylesheet %}
  .ll-collection-description__inner {
    /* 40rem ≈ 66 characters at the brand body size — the readable measure for
       running prose. The header intro is held to 35rem to match the design;
       this is a longer read and takes the wider column. */
    max-width: 40rem;
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .ll-collection-description__inner--ruled {
    padding-block-start: 28px;
    border-block-start: var(--ll-stitch);
  }

  .ll-collection-description__heading {
    margin: 0;
    font-size: 1.375rem; /* 22px — a footnote to the grid, not a second title */
  }

  .ll-collection-description__body {
    color: var(--ll-peat);
    max-height: calc(var(--ll-expandable-lines, 6) * 1.6em);
    max-height: calc(var(--ll-expandable-lines, 6) * 1lh);
    overflow: hidden;
  }

  .ll-collection-description__body--open {
    max-height: none;
  }

  .ll-collection-description__body > :first-child {
    margin-block-start: 0;
  }

  .ll-collection-description__body > :last-child {
    margin-block-end: 0;
  }

  /* Reaches inline `text-align` written by the rich text editor. See the note
     at the top of the file — a stylesheet cannot outrank an inline style
     without this. */
  .ll-collection-description__body--start :is(p, h2, h3, h4, h5, h6, ul, ol, li, blockquote) {
    text-align: start !important;
  }

  /* Fade the cut edge so the clamp reads as "there is more" rather than a
     line that happens to end. Masked rather than a gradient overlay so it
     works over any section background Howard picks. */
  ll-expandable-text[data-overflowing='true']:not([data-expanded='true']) .ll-collection-description__body {
    mask-image: linear-gradient(to bottom, #000 calc(100% - 2.5em), transparent);
  }

  ll-expandable-text[data-expanded='true'] .ll-collection-description__body {
    max-height: none;
  }

  .ll-collection-description__toggle {
    align-self: start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-block-start: 12px;
    padding: 0;
    background: none;
    border: 0;
    font-family: var(--font-body--family);
    font-weight: 800;
    font-size: 0.9375rem; /* 15px */
    color: var(--ll-moor);
    cursor: pointer;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .ll-collection-description__toggle:hover {
    color: var(--ll-moor-hover);
    text-decoration: underline wavy var(--ll-vermillion);
  }

  .ll-collection-description__toggle-caret {
    width: 0;
    height: 0;
    border-inline: 4px solid transparent;
    border-block-start: 5px solid currentcolor;
    transition: transform 0.15s ease;
  }

  /* Only one label is true at a time; the other is removed from the
     accessibility tree with the same rule that hides it visually. */
  .ll-collection-description__toggle [data-when='expanded'],
  ll-expandable-text[data-expanded='true'] .ll-collection-description__toggle [data-when='collapsed'] {
    display: none;
  }

  ll-expandable-text[data-expanded='true'] .ll-collection-description__toggle [data-when='expanded'] {
    display: inline;
  }

  ll-expandable-text[data-expanded='true'] .ll-collection-description__toggle-caret {
    transform: rotate(180deg);
  }

  @media (prefers-reduced-motion: reduce) {
    .ll-collection-description__toggle-caret {
      transition: none;
    }
  }

  .ll-collection-description__placeholder {
    margin: 0;
    font-family: var(--font-accent--family);
    font-size: 1.125rem;
    color: var(--ll-peat);
  }

  @media screen and (max-width: 749px) {
    .ll-collection-description__inner--ruled {
      padding-block-start: 20px;
    }

    .ll-collection-description__heading {
      font-size: 1.25rem; /* 20px */
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection description",
  "enabled_on": {
    "templates": ["collection"]
  },
  "settings": [
    {
      "type": "paragraph",
      "content": "Shows the collection's description from Products → Collections. Long descriptions are collapsed behind a link so they do not push the products down."
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "info": "Leave empty for no heading.",
      "default": "More about this collection"
    },
    {
      "type": "checkbox",
      "id": "show_top_rule",
      "label": "Show stitched rule above",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "normalise_alignment",
      "label": "Align text to the left",
      "info": "Overrides centring applied in the collection description editor. Long text is easier to read left aligned.",
      "default": true
    },
    {
      "type": "header",
      "content": "Collapsing"
    },
    {
      "type": "checkbox",
      "id": "collapse",
      "label": "Collapse long descriptions",
      "default": true
    },
    {
      "type": "range",
      "id": "collapsed_lines",
      "label": "Lines shown when collapsed",
      "min": 3,
      "max": 14,
      "step": 1,
      "default": 6
    },
    {
      "type": "text",
      "id": "more_label",
      "label": "Expand link",
      "default": "Read more"
    },
    {
      "type": "text",
      "id": "less_label",
      "label": "Collapse link",
      "default": "Read less"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "t:settings.background_color",
      "placeholder": "t:settings.default"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 8
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 48
    }
  ],
  "presets": [
    {
      "name": "Collection description",
      "category": "Lighthouse Lane"
    }
  ]
}
{% endschema %}
